          ]
        }
      },
      "name": "Check Quantity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "responseMode": "responseJson",
        "options": {}
      },
      "name": "Valid Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 200],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "valid",
              "name": "valid",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "message",
              "name": "message",
              "value": "Order validated successfully",
              "type": "string"
            }
          ]
